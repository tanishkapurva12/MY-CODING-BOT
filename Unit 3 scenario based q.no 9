import csv

movies = []

with open("movies.csv", "r") as file:
    reader = csv.DictReader(file)

    for row in reader:
        movies.append(row)

print("Movie Collection Records:")

for movie in movies:
    print("Movie ID:", movie["Movie_ID"])
    print("Movie Name:", movie["Movie_Name"])
    print("Genre:", movie["Genre"])
    print("Year:", movie["Year"])
    print("------------------------")
